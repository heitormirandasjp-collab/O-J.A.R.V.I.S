# JARVIS — variáveis de ambiente suportadas pelo backend.
#
# ATENÇÃO: o projeto NÃO carrega .env automaticamente (não há python-dotenv).
# Defina estas variáveis no ambiente do sistema/sessão ANTES de subir o backend:
#   PowerShell (só esta janela):  $env:JARVIS_EXEC_TOKEN="<valor>"
#   PowerShell (permanente):     setx JARVIS_EXEC_TOKEN "<valor>"   # abra nova janela depois
# O arquivo .env está no .gitignore; este .env.example é só documentação.

# ── Obrigatório para /exec e /power (v1.0.16) ─────────────────────────────
# POST /exec e POST /power exigem o header X-Jarvis-Token igual a este valor.
# Sem esta variável definida, as duas rotas respondem 403 (proibido).
# Gere um valor aleatório:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
JARVIS_EXEC_TOKEN=

# ── Opcional ──────────────────────────────────────────────────────────────
# Origens aceitas pelo CORS (padrão: http://127.0.0.1:8755,http://localhost:8755).
# Liste separado por vírgula; nunca use *.
# JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:8755,http://localhost:8755
